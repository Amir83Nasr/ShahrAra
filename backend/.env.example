# ─── DATABASE ────────────────────────────────────────────────
# Dev (docker): keep as-is. Production (Neon): paste the pooled URL and
# the direct one — alembic/Dockerfile use the direct URL for migrations.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/shahr_ara
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shahr_ara
POSTGRES_PORT=5432

# ─── APP ─────────────────────────────────────────────────────
# development | production. Production refuses insecure defaults.
APP_ENV=development

# ─── AUTH ────────────────────────────────────────────────────
JWT_SECRET=shahr-ara-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ─── OTP ─────────────────────────────────────────────────────
# DEV MODE returns the code in the API response instead of sending SMS.
# Development convenience only; production refuses to start with it enabled.
OTP_DEV_MODE=true
OTP_EXPIRATION_MINUTES=2
OTP_MAX_ATTEMPTS=5

# ─── EXPLICIT ADMIN BOOTSTRAP ────────────────────────────────
# Used by `make seed` / `make seed-admin`. Never auto-created by a public
# auth request. Leave empty in production and create the admin explicitly.
ADMIN_PHONE=09000000000
ADMIN_NATIONAL_ID=0370000000
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Admin
# Development convenience only — false in production.
AUTO_CREATE_ADMIN=false

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.20:3000,http://192.168.1.21:3000
